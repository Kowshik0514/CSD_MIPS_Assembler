# Test local jumps
.text
.global main
main:
    iconst 5
    jmp check_value # Forward jump

continue_program:
    iconst 10       # Should eventually reach here
    ret

check_value:
    # A simple conditional simulation (in reality, need compare+jump instructions)
    # If the value was 5 (which it is), jump back
    jmp continue_program # Backward jump