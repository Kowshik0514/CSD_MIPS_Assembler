.global main
.text
main:
    iconst 5
    NEW_ARRAY
    istore 0      # arr1 pointer in local 0

    iconst 3
    NEW_ARRAY
    istore 1      # arr2 pointer in local 1

    iconst 100    # Value
    iconst 2      # Index
    iload 0       # Pointer
    SET_ELEM

    iconst 200    # Value
    iconst 1      # Index
    iload 1       # Pointer
    SET_ELEM

    iconst 2      # Index for arr1[2]
    iload 0       # Pointer for arr1
    GET_ELEM      # Pops index, ptr; Pushes 100

    iconst 1      # Index for arr2[1]
    iload 1       # Pointer for arr2
    GET_ELEM      # Pops index, ptr; Pushes 200

    iadd          # Pops 200, pops 100; Pushes 300
    istore 2      # Store result (300) in local 2

    iload 2       # Load c (300)
    PRINT_I       # Print the integer

    iconst 0
    ret