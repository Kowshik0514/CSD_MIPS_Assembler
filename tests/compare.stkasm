# Tests an if-else block.
# if (10 > 5) { print 1 } else { print 0 }

.global main
.text
main:
    iconst 10
    iconst 5
    icmp_gt         # Pushes 1 (true) since 10 > 5
    jmp_if_false else_block

if_block:
    iconst 1
    PRINT_I
    jmp end_if

else_block:
    iconst 0
    PRINT_I

end_if:
    iconst 0
    ret